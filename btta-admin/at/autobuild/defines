PKGNAME=at
PKGSEC=admin
PKGDEP="linux-pam flex at-sysusers"
# at requires a sendmail program to build
BUILDDEP="exim"
PKGDES="AT and batch delayed command scheduling utility and daemon"

AUTOTOOLS_AFTER=(
	--with-jobdir=/var/spool/atd
	--with-atspool=/var/spool/atd
	--with-systemdsystemunitdir=/usr/lib/systemd/system
	--with-daemon_username=atd
	--with-daemon_groupname=atd
)
ABSHADOW=0
